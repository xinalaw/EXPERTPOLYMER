# ============================================================================
#  Окружение объединённого проекта. Скопировать в .env и заполнить.
# ============================================================================

# --- PostgreSQL --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5434
DB_NAME=scientific_system
DB_USER=postgres
DB_PASSWORD=admin

# Полный URL для SQLAlchemy
DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5434/scientific_system

# Отдельная база для pytest (backend/tests)
TEST_DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5434/scientific_system_test

# --- JWT ---------------------------------------------------------------------
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Celery / Redis ----------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Экспертная система ------------------------------------------------------
# auto          — ядро, если пакет импортируется и найдены веса; иначе заглушка
# expert_system — только ядро (падать, если недоступно)
# mock          — только заглушка (тесты, CI, разработка фронтенда)
ML_BACKEND=auto

# 1 — не откатываться на заглушку при ошибке ядра, а возвращать ошибку задачи
ML_STRICT=0

# Переопределения путей ядра (по умолчанию считаются от корня репозитория)
# ES_MODEL_PATH=data/models/yolo_particles_seg.pt
# ES_RESULTS_DIR=data/results
# ES_CONFIDENCE_THRESHOLD=0.25
